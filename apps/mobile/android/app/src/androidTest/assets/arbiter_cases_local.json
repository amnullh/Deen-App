{
  "_comment": "Small local subset for the Kotlin arbiter and alert-ID rules. The shared vectors live in packages/schedule_planner/test_vectors/ (workstream W2) and use this same shape: ledger entries carry alertId and state (fired, played, acknowledged, suppressed, failed); kind is one of prayer, preReminder, suhoor, adhkarReminder, renewal.",
  "arbiter": [
    {"name": "empty ledger plays", "ledger": [], "alertId": "fajr:2026-10-21", "expectPlay": true},
    {"name": "played id is refused", "ledger": [{"alertId": "fajr:2026-10-21", "state": "played"}], "alertId": "fajr:2026-10-21", "expectPlay": false},
    {"name": "other id still plays", "ledger": [{"alertId": "fajr:2026-10-21", "state": "played"}], "alertId": "dhuhr:2026-10-21", "expectPlay": true},
    {"name": "same prayer next day plays", "ledger": [{"alertId": "fajr:2026-10-21", "state": "played"}], "alertId": "fajr:2026-10-22", "expectPlay": true},
    {"name": "pre reminder is its own id", "ledger": [{"alertId": "asr:2026-10-21:pre", "state": "played"}], "alertId": "asr:2026-10-21", "expectPlay": true},
    {"name": "fired only still plays", "ledger": [{"alertId": "isha:2026-10-21", "state": "fired"}], "alertId": "isha:2026-10-21", "expectPlay": true},
    {"name": "failed attempt can be retried", "ledger": [{"alertId": "maghrib:2026-10-21", "state": "failed"}], "alertId": "maghrib:2026-10-21", "expectPlay": true},
    {"name": "suppressed attempt can be retried", "ledger": [{"alertId": "maghrib:2026-10-21", "state": "suppressed"}], "alertId": "maghrib:2026-10-21", "expectPlay": true},
    {"name": "played then acknowledged stays refused", "ledger": [{"alertId": "fajr:2026-10-21", "state": "played"}, {"alertId": "fajr:2026-10-21", "state": "acknowledged"}], "alertId": "fajr:2026-10-21", "expectPlay": false}
  ],
